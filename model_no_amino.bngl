begin model

begin parameters
    #diffusion constants
    D_VOL 1e-6 # cm^2/s
    MCELL_DIFFUSION_CONSTANT_3D_P D_VOL
    MCELL_DIFFUSION_CONSTANT_3D_BkP D_VOL
    MCELL_DIFFUSION_CONSTANT_3D_Ribo D_VOL
    #MCELL_DIFFUSION_CONSTANT_3D_mRNA_l D_VOL
    #MCELL_DIFFUSION_CONSTANT_3D_mRNA_s D_VOL
    MCELL_DIFFUSION_CONSTANT_3D_nucl D_VOL
    
    NA_um3 6.022e8 # Avogadro's number mutiplied by 1e-15 since we are using volume units of microns(^-3)

    # Initial number molecules
    P_i 0
    BkP_i 0  #count for how many proteins have been degraded
    nucl_l 50
    nucl_s 50
    Ribo_i 200  #move to jupyter notebook as we want to change this between runs

    #rates
    deg_r  0.005          #unimolecular (1/s)
    init_r  1e+15/NA_um3   #bimolecular  (1/s or 1/# "NA * V ")
    elong_r  1.15         #unimolecular
    term_r   1.15          #unimolecular
    
         

    # Units: volumes in um3
    #VolPM 0.0307
    VolCP 0.1#50588 
 
end parameters

begin compartments
    #PM 2 VolPM
    CP 3 VolCP #3Dimensions and 1 microcubic in volume, volume compartment , only need one for now, 
end compartments

begin molecule types
    P(s~0~1)
    BkP
    nucl(l,r,R,i~0~1,t~0~1,s~0~1) 
    Ribo(N)
end molecule types

begin species
    @CP:P(s~0) P_i
    #phantom protein, should be endless
    @CP:BkP BkP_i
    #ribosomes
    @CP:Ribo(N) Ribo_i
    #mRNA
    @CP:nucl(R,t~0,i~1,s~1,r!1,l).nucl(R,t~0,i~0,s~1,l!1,r!2).nucl(R,t~1,i~0,s~1,l!2,r) nucl_s
    
    #@CP:nucl(R,t~0,i~1,s~1,r!1,l).nucl(R,t~0,i~0,s~1,l!1,r!2).nucl(R,t~0,i~0,s~1,l!2,r!3).nucl(R,t~0,i~0,s~1,l!3,r!4).nucl(R,t~0,i~0,s~1,l!4,r!5).nucl(R,t~0,i~0,s~1,l!5,r!6).nucl(R,t~0,i~0,s~1,l!6,r!7).nucl(R,t~0,i~0,s~1,l!7,r!8).nucl(R,t~0,i~0,s~1,l!8,r!9).nucl(R,t~0,i~0,s~1,l!9,r!10).nucl(R,t~0,i~0,s~1,l!10,r!11).nucl(R,t~0,i~0,s~1,l!11,r!12).nucl(R,t~0,i~0,s~1,l!12,r!13).nucl(R,t~0,i~0,s~1,l!13,r!14).nucl(R,t~0,i~0,s~1,l!14,r!15).nucl(R,t~0,i~0,s~1,l!15,r!16).nucl(R,t~0,i~0,s~1,l!16,r!17).nucl(R,t~0,i~0,s~1,l!17,r!18).nucl(R,t~0,i~0,s~1,l!18,r!19).nucl(R,t~1,i~0,s~1,l!19,r) nucl_s
    
    
    @CP:nucl(R,t~0,i~1,s~0,r!1,l).nucl(R,t~0,i~0,s~0,l!1,r!2).nucl(R,t~0,i~0,s~0,l!2,r!3).nucl(R,t~1,i~0,s~0,l!3,r) nucl_l
    
#    @CP:nucl(R,t~0,i~1,s~0,r!1,l).nucl(R,t~0,i~0,s~0,l!1,r!2).nucl(R,t~0,i~0,s~0,l!2,r!3).nucl(R,t~0,i~0,s~0,l!3,r!4).nucl(R,t~0,i~0,s~0,l!4,r!5).nucl(R,t~0,i~0,s~0,l!5,r!6).nucl(R,t~0,i~0,s~0,l!6,r!7).nucl(R,t~0,i~0,s~0,l!7,r!8).nucl(R,t~0,i~0,s~0,l!8,r!9).nucl(R,t~0,i~0,s~0,l!9,r!10).nucl(R,t~0,i~0,s~0,l!10,r!11).nucl(R,t~0,i~0,s~0,l!11,r!12).nucl(R,t~0,i~0,s~0,l!12,r!13).nucl(R,t~0,i~0,s~0,l!13,r!14).nucl(R,t~0,i~0,s~0,l!14,r!15).nucl(R,t~0,i~0,s~0,l!15,r!16).nucl(R,t~0,i~0,s~0,l!16,r!17).nucl(R,t~0,i~0,s~0,l!17,r!18).nucl(R,t~0,i~0,s~0,l!18,r!19).nucl(R,t~0,i~0,s~0,l!19,r!20).nucl(R,t~0,i~0,s~0,l!20,r!21).nucl(R,t~0,i~0,s~0,l!21,r!22).nucl(R,t~0,i~0,s~0,l!22,r!23).nucl(R,t~0,i~0,s~0,l!23,r!24).nucl(R,t~0,i~0,s~0,l!24,r!25).nucl(R,t~0,i~0,s~0,l!25,r!26).nucl(R,t~0,i~0,s~0,l!26,r!27).nucl(R,t~0,i~0,s~0,l!27,r!28).nucl(R,t~0,i~0,s~0,l!28,r!29).nucl(R,t~0,i~0,s~0,l!29,r!30).nucl(R,t~0,i~0,s~0,l!30,r!31).nucl(R,t~0,i~0,s~0,l!31,r!32).nucl(R,t~0,i~0,s~0,l!32,r!33).nucl(R,t~0,i~0,s~0,l!33,r!34).nucl(R,t~0,i~0,s~0,l!34,r!35).nucl(R,t~0,i~0,s~0,l!35,r!36).nucl(R,t~0,i~0,s~0,l!36,r!37).nucl(R,t~0,i~0,s~0,l!37,r!38).nucl(R,t~0,i~0,s~0,l!38,r!39).nucl(R,t~0,i~0,s~0,l!39,r!40).nucl(R,t~0,i~0,s~0,l!40,r!41).nucl(R,t~0,i~0,s~0,l!41,r!42).nucl(R,t~0,i~0,s~0,l!42,r!43).nucl(R,t~0,i~0,s~0,l!43,r!44).nucl(R,t~0,i~0,s~0,l!44,r!45).nucl(R,t~0,i~0,s~0,l!45,r!46).nucl(R,t~0,i~0,s~0,l!46,r!47).nucl(R,t~0,i~0,s~0,l!47,r!48).nucl(R,t~0,i~0,s~0,l!48,r!49).nucl(R,t~0,i~0,s~0,l!49,r!50).nucl(R,t~0,i~0,s~0,l!50,r!51).nucl(R,t~0,i~0,s~0,l!51,r!52).nucl(R,t~0,i~0,s~0,l!52,r!53).nucl(R,t~0,i~0,s~0,l!53,r!54).nucl(R,t~0,i~0,s~0,l!54,r!55).nucl(R,t~0,i~0,s~0,l!55,r!56).nucl(R,t~0,i~0,s~0,l!56,r!57).nucl(R,t~0,i~0,s~0,l!57,r!58).nucl(R,t~0,i~0,s~0,l!58,r!59).nucl(R,t~0,i~0,s~0,l!59,r!60).nucl(R,t~0,i~0,s~0,l!60,r!61).nucl(R,t~0,i~0,s~0,l!61,r!62).nucl(R,t~0,i~0,s~0,l!62,r!63).nucl(R,t~0,i~0,s~0,l!63,r!64).nucl(R,t~0,i~0,s~0,l!64,r!65).nucl(R,t~0,i~0,s~0,l!65,r!66).nucl(R,t~0,i~0,s~0,l!66,r!67).nucl(R,t~0,i~0,s~0,l!67,r!68).nucl(R,t~0,i~0,s~0,l!68,r!69).nucl(R,t~0,i~0,s~0,l!69,r!70).nucl(R,t~0,i~0,s~0,l!70,r!71).nucl(R,t~0,i~0,s~0,l!71,r!72).nucl(R,t~0,i~0,s~0,l!72,r!73).nucl(R,t~0,i~0,s~0,l!73,r!74).nucl(R,t~0,i~0,s~0,l!74,r!75).nucl(R,t~0,i~0,s~0,l!75,r!76).nucl(R,t~0,i~0,s~0,l!76,r!77).nucl(R,t~0,i~0,s~0,l!77,r!78).nucl(R,t~0,i~0,s~0,l!78,r!79).nucl(R,t~0,i~0,s~0,l!79,r!80).nucl(R,t~1,i~0,s~0,l!80,r) nucl_l
    
end species


begin reaction rules
    #protein degradation
    #P -> BkP deg_r
    #ribosome binds to mRNA
    nucl(R, t~0, i~1) + Ribo(N) -> nucl(R!1, t~0, i~1).Ribo(N!1) init_r
    #ribosome advances on mRNA
    nucl(R!2, r!1).Ribo(N!2).nucl(R, l!1) -> nucl(R,r!1).nucl(R!3,l!1).Ribo(N!3) elong_r
    
    
    #ribsome is at termination point
    nucl(R!1, t~1, s~0).Ribo(N!1)-> P(s~0)+ nucl(R, t~1, s~0)+ Ribo(N) term_r
    nucl(R!1, t~1, s~1).Ribo(N!1)-> P(s~1)+ nucl(R, t~1, s~1)+ Ribo(N) term_r
    #complexes dont move and are treated as surfaces
    
end reaction rules
    
    

begin observables
    Molecules r Ribo(N)
    
    Molecules p_l P(s~0)
    Molecules r_initiated_long nucl(R!1, i~1, s~0).Ribo(N!1)
    Molecules r_elongating_long nucl(R!1, t~0, i~0, s~0).Ribo(N!1)
    Molecules r_terminating_long nucl(R!1, t~1, i~0, s~0).Ribo(N!1)
    
    Molecules p_s P(s~1)
    Molecules r_initiated_short nucl(R!1, i~1, s~1).Ribo(N!1)
    Molecules r_elongating_short nucl(R!1, t~0, i~0, s~1).Ribo(N!1)
    Molecules r_terminating_short nucl(R!1, t~1, i~0, s~1).Ribo(N!1)
end observables


end model
